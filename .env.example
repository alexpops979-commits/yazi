# ─────────────────────────────────────────────────────────────
#  Infrastructure
# ─────────────────────────────────────────────────────────────
# Postgres (Neon / Supabase / local install / docker compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dalmg?schema=public"
# Redis (Upstash / local install / docker compose). Optional: API falls back to in-memory cache.
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────────────────────
#  App
# ─────────────────────────────────────────────────────────────
API_PORT=3001
API_PUBLIC_URL="http://localhost:3001"
# Host that serves the dashboard (no port in production, e.g. app.dalmg.dev)
APP_HOST="localhost:3002"
NEXT_PUBLIC_APP_URL="http://localhost:3002"
# Base domain for generated subdomains. lvh.me resolves to 127.0.0.1 for local testing.
SITE_DOMAIN="lvh.me:3002"
NEXT_PUBLIC_SITE_DOMAIN="lvh.me:3002"

JWT_SECRET="dev-only-change-me-please-0123456789abcdef"
INTERNAL_TOKEN="dev-internal-token-change-me"

# Accounts and plans (see README)
SINGLE_WORKSPACE=true
PLANS_ENFORCED=false

# ─────────────────────────────────────────────────────────────
#  Stripe (test mode keys are fine)
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""

# ─────────────────────────────────────────────────────────────
#  Object storage (Cloudflare R2 / AWS S3 / MinIO). Empty = local disk storage.
# ─────────────────────────────────────────────────────────────
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ─────────────────────────────────────────────────────────────
#  Seed
# ─────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@dalmg.dev"
ADMIN_PASSWORD="admin12345"
DEMO_EMAIL="demo@dalmg.dev"
DEMO_PASSWORD="demo12345"
